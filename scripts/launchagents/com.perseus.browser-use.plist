<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.perseus.browser-use</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd /opt/perseus/repo &amp;&amp; /opt/homebrew/bin/uv run --project /opt/perseus/repo/tools/browser-use python /opt/perseus/repo/scripts/browser-use-sidecar-server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/perseus/repo</string>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/opt/perseus/repo/logs/browser-use-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/perseus/repo/logs/browser-use-launchd-err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>CLAWDBOT_BROWSER_USE_ENABLED</key>
        <string>1</string>
        <key>CLAWDBOT_BROWSER_USE_SESSION</key>
        <string>clawdbot-browser</string>
        <key>CLAWDBOT_BROWSER_USE_BROWSER</key>
        <string>chromium</string>
        <key>CLAWDBOT_BROWSER_USE_HEADED</key>
        <string>0</string>
        <key>BROWSER_USE_URL</key>
        <string>http://localhost:3031</string>
    </dict>
</dict>
</plist>
