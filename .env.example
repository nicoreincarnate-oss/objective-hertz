# ─── PERSEUS — Environment Variables ────────────────────────────────
# Copy to .env and fill in real values: cp .env.example .env

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=perseus
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=perseus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── N8N ───────────────────────────────────────────────────────────
N8N_USER=perseus
N8N_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
WEBHOOK_URL=http://localhost:5678

# ── Claude API (Primary Brain — via Claude Max $200/mo) ──────────
ANTHROPIC_API_KEY=CHANGE_ME
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
CLAUDE_PRIMARY_MODEL=claude-sonnet-4-6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# ── Ollama (Local Fallback) ──────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_SECONDARY=llama3.2:3b
OLLAMA_EMBED=nomic-embed-text

# ── AirLLM (Heavy Local Research / Memory Lane) ──────────────────
# AirLLM is best for long-context offline analysis, not low-latency voice chat.
AIRLLM_ENABLED=false
AIRLLM_MODEL=Qwen/Qwen2.5-72B-Instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_PROFILING_MODE=false
AIRLLM_HF_TOKEN=
AIRLLM_LAYER_SHARDS_PATH=
AIRLLM_PROMPT_CHAR_THRESHOLD=12000
AIRLLM_PREFERRED_STAGES=research,intel,scout,paper,memory,sleep_cycle,digest,summary

# ── oLLM (Ultra-Large Local Context Lane) ─────────────────────────
# Use when jobs are enormous offline passes: huge logs, contracts, compliance.
OLLM_ENABLED=false
OLLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
OLLM_PROMPT_CHAR_THRESHOLD=40000
OLLM_PREFERRED_STAGES=deep_research,huge_context,log_analysis,contract_analysis,compliance,screen_digest
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28

# ── Screenpipe Sidecar (live screen_context) ─────────────────────
SCREENPIPE_ENABLED=true
SCREENPIPE_URL=http://localhost:3030
SCREENPIPE_START_COMMAND=npx -y screenpipe@latest record
SCREENPIPE_SCREEN_CONTEXT_LIMIT=1
SCREENPIPE_SCREEN_CONTEXT_INCLUDE_FRAMES=true
SCREENPIPE_SCREEN_CONTEXT_CONTENT_TYPE=
SYSTEM_EXECUTOR_BACKENDS=screenpipe,peekaboo,cua,hammerspoon,local
SYSTEM_EXECUTOR_SCREENPIPE_URL=http://localhost:3030

# ── Hermes Agent (Nous Research — installed via official script) ──
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# ── OpenHands (repo/code tasks) ─────────────────────────────────
# Use a LiteLLM-style model name, e.g. provider/model.
LLM_API_KEY=CHANGE_ME
OPENHANDS_MODEL=
OPENHANDS_WORKSPACE=.

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_ADMIN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── Instantly.ai (cold outreach — campaign-based) ─────────────────
INSTANTLY_API_KEY=CHANGE_ME

# ── Firecrawl (web extraction) ───────────────────────────────────
FIRECRAWL_API_KEY=CHANGE_ME

# ── Composio (Gmail / Google Drive / QuickBooks) ─────────────────
COMPOSIO_API_KEY=CHANGE_ME

# ── Payments (whatever works in Mexico) ──────────────────────────
WISE_API_TOKEN=CHANGE_ME
WISE_PROFILE_ID=CHANGE_ME
STRIPE_API_KEY=CHANGE_ME

# ── Site Building (v0.dev API by Vercel — primary builder) ──────
V0_API_KEY=CHANGE_ME

# ── Image Generation (Recraft AI — logos, visuals, graphics) ────
# Get from: https://www.recraft.ai/docs/api-reference/getting-started
# Cost: ~$0.01/image. Budget impact negligible.
RECRAFT_API_KEY=CHANGE_ME

# ── Hosting (Netlify / Vercel / Cloudflare — AI decides) ───────
NETLIFY_AUTH_TOKEN=CHANGE_ME
VERCEL_TOKEN=CHANGE_ME

# ── Cloud GPU (training — on demand) ────────────────────────────
VAST_AI_API_KEY=CHANGE_ME

# ── Vector DB + Memory ───────────────────────────────────────────
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=perseus
MEM0_HOST=http://localhost:8888

# ── Budget ($800/month total) ────────────────────────────────────
MONTHLY_BUDGET_CAP=800
BUDGET_ALERT_THRESHOLD=0.80
CLOUD_GPU_BUDGET_CAP=200

# ── Autonomy ─────────────────────────────────────────────────────
REVIEW_MODE=true
SALES_BEFORE_AUTONOMY=10

# ── Pricing (starting prices — AI adjusts based on market) ──────
PRICE_WEBSITE_5PAGE=299
PRICE_LANDING_PAGE=149
PRICE_HOSTING_MONTHLY=52
PRICE_RECEPTIONIST_MONTHLY=398
COST_RECEPTIONIST_VENDOR=79

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=text
LOG_TO_STDOUT=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Compliance ───────────────────────────────────────────────────
# company_address + unsubscribe_base_url live in system_config so they can be
# updated without a redeploy. The signing secret stays in env.
UNSUBSCRIBE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── Dashboard ────────────────────────────────────────────────────
# Secret token for web dashboard access. Pass as ?token=<secret> in the URL.
# Leave empty for open access (local dev only).
DASHBOARD_SECRET=CHANGE_ME_TO_A_RANDOM_TOKEN
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8500

# ── Orchestrator / A2A ─────────────────────────────────────────────
ORCHESTRATOR_A2A_PORT=9000
TITAN_A2A_PORT=9001
HERMES_A2A_PORT=9002
CLAWDBOT_A2A_PORT=9003
SCHEDULER_TICK_INTERVAL=60
USE_A2A_DISPATCH=1
CLAUDE_GENIUS_MODEL=claude-opus-4

# ── System Executor / Peekaboo backend ───────────────────────────
SYSTEM_EXECUTOR_A2A=1
SYSTEM_EXECUTOR_A2A_PORT=9010
# Primary live backend order for system_executor.
SYSTEM_EXECUTOR_BACKENDS=peekaboo,screenpipe,cua,hammerspoon,local
# Point these at the live services; leave empty to fall back locally.
SYSTEM_EXECUTOR_PEEKABOO_URL=
PEEKABOO_URL=
SYSTEM_EXECUTOR_SCREENPIPE_URL=http://localhost:3030
SCREENPIPE_URL=http://localhost:3030
SYSTEM_EXECUTOR_CUA_URL=
CUA_URL=

# ── ClawdBot Voice / WhatsApp / Android ────────────────────────────
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
ADB_SERIAL=
CLAWDBOT_ENABLE_WHATSAPP=false
CLAWDBOT_ENABLE_VOICE=false

# ── ClawdBot browser-use sidecar (browser_flow backend) ─────────────
CLAWDBOT_BROWSER_USE_ENABLED=true
CLAWDBOT_BROWSER_USE_SESSION=clawdbot-browser
CLAWDBOT_BROWSER_USE_BROWSER=chromium
CLAWDBOT_BROWSER_USE_HEADED=false
CLAWDBOT_BROWSER_USE_PROFILE=
BROWSER_USE_URL=http://localhost:3031
BROWSER_USE_START_CMD=cd /Users/majovega/Desktop/Projects/objective-hertz && uv run --project /Users/majovega/Desktop/Projects/objective-hertz/tools/browser-use python /Users/majovega/Desktop/Projects/objective-hertz/scripts/browser-use-sidecar-server.py

# ── Ruflo Engineering Agent ────────────────────────────────────────
RUFLO_ENABLED=false
RUFLO_A2A_URL=http://localhost:9004
RUFLO_A2A_PORT=9004
RUFLO_CLAUDE_MONTHLY_CAP=50
RUFLO_MAX_SWARMS=1
RUFLO_SWARM_TIMEOUT=900
RUFLO_AUTO_APPLY=false

# ── Full Integration ─────────────────────────────────────────────
APIFY_API_TOKEN=
TAVILY_API_KEY=
TWENTYFIRST_API_KEY=
USE_OJ_ENGINE=false

# ─── Phase 42.5 v2 Local Tier ──────────────────────────────────

# ── Crypto / secrets (REQUIRED — daemons fail-closed if missing) ──
# Conway keystore password — encrypts Base L2 USDC wallet private keys. If missing, Conway refuses to start.
CONWAY_KEYSTORE_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# LiteLLM proxy master admin key — gates /key/generate and admin endpoints. If missing, proxy refuses to boot.
LITELLM_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# LiteLLM salt key — encrypts provider API keys stored in LiteLLM's Postgres. If missing, key storage fails.
LITELLM_SALT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── Cloud LLM keys (optional — fall back to direct Anthropic if missing) ──
# OpenRouter — unified proxy for 100+ models (Kimi K2.5, DeepSeek, Gemini). Optional; missing → skip OpenRouter routes.
OPENROUTER_API_KEY=CHANGE_ME
# Google Gemini direct API. Optional; missing → LiteLLM skips Gemini routes and falls back to OpenRouter/Anthropic.
GEMINI_API_KEY=CHANGE_ME
# DeepSeek direct API (cheap reasoning tier). Optional; missing → falls back to OpenRouter or Anthropic.
DEEPSEEK_API_KEY=CHANGE_ME

# ── Local LLM endpoints (M4 Max local tier) ──
# Parakeet ASR endpoint (voice → text). Default localhost; missing → voice loop degrades to cloud Whisper.
PARAKEET_API_BASE=http://127.0.0.1:11440
# Kokoro TTS endpoint (text → voice). Default localhost; missing → voice loop falls back to cloud TTS.
KOKORO_API_BASE=http://127.0.0.1:11441
# Draw Things image gen endpoint (local SDXL/Flux). Default localhost; missing → falls back to Recraft/Nano Banana.
DRAW_THINGS_API_BASE=http://127.0.0.1:7860
# AirLLM local heavy tier auth key (Llama 70B on M4 Max). Empty for now — AirLLM integration is deferred.
AIRLLM_LOCAL_KEY=

# ── Observability (Langfuse + ClickHouse) ──
# Langfuse self-hosted host URL (traces, evals, prompt versioning). Default localhost; missing → tracing disabled.
LANGFUSE_HOST=http://localhost:3030
# Langfuse public key (project identifier). Missing → LiteLLM skips trace emission.
LANGFUSE_PUBLIC_KEY=CHANGE_ME
# Langfuse secret key (auth for trace ingest). Missing → LiteLLM skips trace emission.
LANGFUSE_SECRET_KEY=CHANGE_ME
# ClickHouse password — Langfuse analytics backend. Missing → Langfuse falls back to Postgres-only (slower).
CLICKHOUSE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ── Feature flags (all default OFF — flip ON during Phase 42.5 cutover) ──
# Master switch for the local tier (M4 Max multi-model stack). Default off until cutover complete.
LOCAL_TIER_ENABLED=false
# Enable tiered routing (local → cloud cascade) inside LiteLLM. Off → direct-to-Anthropic legacy path.
TIERED_ROUTING_ENABLED=false
# Enable automatic tier selection based on task complexity. Off → caller must pick tier explicitly.
AUTO_TIER_ENABLED=false
# Enable Langfuse trace emission from LiteLLM. Off → no observability (cheaper, but blind).
LANGFUSE_ENABLED=false
# Enable semantic cache (Redis-backed) for LLM responses. Off → every call hits the provider.
SEMANTIC_CACHE_ENABLED=false
# Enable LiteLLM proxy as the primary LLM gateway. Off → bypass proxy and call Anthropic directly.
LITELLM_PROXY_ENABLED=false
# Shadow mode: call LiteLLM in parallel with legacy path but only use legacy's response. For canary testing.
LITELLM_SHADOW_MODE=false
# Percentage of traffic routed through LiteLLM (0-100). 0 = off, 100 = full cutover. Used with shadow mode.
LITELLM_ROLLOUT_PCT=0

# Phase 3 Wave 2+3 — Aider architect+editor loops (opt-in)
ENABLE_AIDER_LOOPS=false

# Phase 3 Wave 4 — Hermes voice loop (Parakeet ASR + Kokoro TTS, opt-in)
# Stays dead until operator runs Phase 42.5 v2 install checklist for Parakeet/Kokoro daemons.
ENABLE_VOICE_LOOP=false
