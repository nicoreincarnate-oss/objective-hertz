{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "hermes/web/frontend"
    },
    {
      "name": "athena",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8090"],
      "port": 8090,
      "autoPort": false,
      "cwd": "athena-site"
    },
    {
      "name": "api",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "hermes.web.app:app", "--host", "0.0.0.0", "--port", "8500", "--reload"],
      "port": 8500
    },
    {
      "name": "explorer",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080,
      "cwd": "docs"
    }
  ]
}
