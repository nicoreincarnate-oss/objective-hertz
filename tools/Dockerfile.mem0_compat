FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.135.1 \
    mem0ai==1.0.6 \
    uvicorn==0.42.0 \
    pydantic==2.11.10

COPY tools /app/tools

ENV MEM0_HISTORY_DB_PATH=/data/history.db
ENV PYTHONPATH=/app

EXPOSE 8888

CMD ["uvicorn", "tools.mem0_compat_service:app", "--host", "0.0.0.0", "--port", "8888"]
